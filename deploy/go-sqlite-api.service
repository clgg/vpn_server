[Unit]
Description=Go SQLite API
After=network-online.target
Wants=network-online.target

[Service]
User=goapi
Group=goapi
WorkingDirectory=/opt/apps/go-sqlite-api
Environment=ADDR=127.0.0.1:8080
Environment=DB_PATH=/var/lib/go-sqlite-api/app.db
Environment=VERSION=1.0.0
EnvironmentFile=-/etc/go-sqlite-api/vpn.env
	SupplementaryGroups=systemd-journal
ExecStart=/opt/apps/go-sqlite-api/go-sqlite-api
Restart=always
RestartSec=3
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/var/lib/go-sqlite-api /etc/sing-box /var/lib/sing-box /usr/local/etc/xray /var/log/xray

[Install]
WantedBy=multi-user.target
