VPN_ADMIN_EMAIL=admin@example.com
VPN_ADMIN_PASSWORD=change-me-before-use
VPN_SERVER_HOST=your-server-ip-or-domain
VPN_SERVER_PORT=443
VPN_DEFAULT_USER_NAME=owner
VPN_DEFAULT_USER_UUID=replace-with-owner-uuid
VPN_REALITY_SNI=www.cloudflare.com
VPN_REALITY_PRIVATE_KEY=replace-with-reality-private-key
VPN_REALITY_PUBLIC_KEY=replace-with-reality-public-key
VPN_REALITY_SHORT_ID=replace-with-reality-short-id
VPN_SING_BOX_CANDIDATE=/var/lib/go-sqlite-api/sing-box-config.json
VPN_TRAFFIC_INTERFACE=ens5
VPN_CLASH_API_LISTEN=127.0.0.1:9090
VPN_CLASH_API_SECRET=replace-with-random-secret
